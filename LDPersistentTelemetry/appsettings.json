{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PersistentStoreTelemetry": {
    "ScrapeInterval": "00:05:00"
  },
  "Redis": {
    "Mtls": {
      "ClientCertificatePath": "",
      "ClientPrivateKeyPath": "",
      "CaCertificatePath": ""
    }
  },
  "Aspire": {
    "StackExchange": {
      "Redis": {
        "ConfigurationOptions": {
          "AllowAdmin": true
        }
      }
    }
  }
}
